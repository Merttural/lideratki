# Google Ads measurement (optional). Leave empty until the Ads conversion action exists.
# Example: AW-1234567890
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversion labels from Google Ads → Goals → Conversions (optional but recommended).
# Without a label, WhatsApp/phone clicks still send a custom gtag event to the Ads ID.
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_LABEL=
